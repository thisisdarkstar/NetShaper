<Window x:Class="NetShaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetShaper.Controls"
        Title="NetShaper - Bandwidth Controller"
        Height="740" Width="1120"
        MinHeight="620" MinWidth="900"
        Background="#08080A"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="Resources/netshaper_icon.ico">
    <Window.Resources>
        <!-- Ensure DataGrid internal ScrollViewer inherits the dark ScrollBar style -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#111115" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#111115" />
            <Setter Property="AlternatingRowBackground" Value="#15151B" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1B1B22" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingStackPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Global Interception Card -->
            <RowDefinition Height="Auto" />
            <!-- 2: Splitter (Process List + Policy Controls) -->
            <RowDefinition Height="*" />
            <!-- 3: Console Log Output Panel -->
            <RowDefinition Height="110" />
            <!-- 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header Banner -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="⚡ NETSHAPER"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#00F0FF" />
                <TextBlock Text="Real-Time Traffic Shaper &amp; Network Socket Inspector"
                           FontSize="12"
                           Foreground="#828292"
                           Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#1B1B22"
                    BorderBrush="#252530"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StatusSocksLabel"
                           Text="SOCKS5 ENGINE ACTIVE: PORT 1080"
                           Foreground="#00FF88"
                           FontWeight="Bold"
                           FontSize="11" />
            </Border>
        </Grid>

        <!-- 1. Global Interception Card -->
        <Border Grid.Row="1"
                Background="#111115"
                BorderBrush="#1D1D22"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GlowDot"
                           Grid.Column="0"
                           Text="●"
                           Foreground="#828292"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <TextBlock Grid.Column="1"
                           Text="SYSTEM-WIDE TRAFFIC INTERCEPTION"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="(Reroutes network sockets through SOCKS proxy)"
                           Foreground="#828292"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />

                <TextBlock x:Name="InterceptStateLabel"
                           Grid.Column="4"
                           Text="INACTIVE"
                           Foreground="#828292"
                           FontWeight="Bold"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <controls:ToggleSwitch x:Name="ProxyToggle"
                                       Grid.Column="5"
                                       VerticalAlignment="Center"
                                       CheckedChanged="OnProxyToggleChanged" />
            </Grid>
        </Border>

        <!-- 2. Splitter (Process List Left, Policy Controls Right) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" MinWidth="440" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Process Activity Monitor -->
            <Border Grid.Column="0"
                    Background="#111115"
                    BorderBrush="#1D1D22"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍 FILTER PROCESS:"
                                   Foreground="#00F0FF"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 TextChanged="OnSearchTextChanged"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0" />
                        <CheckBox x:Name="ActiveOnlyCheckBox"
                                  Grid.Column="2"
                                  Content="Active network only"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Click="OnActiveOnlyChanged" />
                    </Grid>

                    <!-- Process DataGrid with Virtualization & Dark Scrollbar -->
                    <DataGrid x:Name="ProcessGrid"
                              Grid.Row="1"
                              Foreground="#FFFFFF"
                              FontSize="12"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              SelectionChanged="OnProcessSelectionChanged"
                              MouseDoubleClick="OnProcessDoubleClicked">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111115" />
                                <Setter Property="Foreground" Value="#828292" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#1D1D22" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Padding" Value="0,4" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0A84FF" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Instances" Binding="{Binding Instances}" Width="60" />
                            <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Active Sockets" Binding="{Binding ConnsDisplay}" Width="95" />
                            <DataGridTemplateColumn Header="Speed Rate" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SpeedDisplay}"
                                                   Foreground="#00FF88"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DL Limit" Binding="{Binding DlLimit}" Width="85" />
                            <DataGridTextColumn Header="UL Limit" Binding="{Binding UlLimit}" Width="85" />
                            <DataGridTextColumn Header="Executable Path" Binding="{Binding ExecutablePath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="StatusProcsLabel"
                               Grid.Row="2"
                               Text="Scanning operating system processes..."
                               Foreground="#828292"
                               FontSize="11"
                               Margin="2,8,0,0" />
                </Grid>
            </Border>

            <!-- Splitter Grip -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE" />

            <!-- RIGHT PANEL: Throttler Form & Rules DB -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- CARD 1: Policy Editor -->
                <Border Grid.Row="0"
                        Background="#111115"
                        BorderBrush="#1D1D22"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚡ APP BANDWIDTH THROTTLER"
                                   Foreground="#00F0FF"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Target Executable File / Path:"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Margin="0,0,0,4" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExeEntry"
                                     Grid.Column="0"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,6,0" />
                            <Button x:Name="BrowseBtn"
                                    Grid.Column="1"
                                    Height="32"
                                    Content="📁 Browse"
                                    Click="OnBrowseClicked"
                                    Margin="0,0,6,0" />
                            <Button x:Name="LaunchBtn"
                                    Grid.Column="2"
                                    Height="32"
                                    Content="🚀 Run Throttled"
                                    Background="#0A84FF"
                                    BorderBrush="#0A84FF"
                                    Click="OnLaunchThrottledClicked" />
                        </Grid>

                        <!-- Download Limit Row -->
                        <CheckBox x:Name="DlCheckBox"
                                  Content="Limit Download Speed (DL)"
                                  Foreground="#00FF88"
                                  FontWeight="Bold"
                                  IsChecked="True"
                                  Click="OnLimitCheckBoxClicked"
                                  Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DlValEntry"
                                     Grid.Column="0"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="5"
                                     Margin="0,0,6,0" />
                            <ComboBox x:Name="DlUnitCombo"
                                      Grid.Column="1"
                                      Height="32"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="MB/s" />
                                <ComboBoxItem Content="KB/s" />
                                <ComboBoxItem Content="Mbps" />
                                <ComboBoxItem Content="Kbps" />
                            </ComboBox>
                        </Grid>

                        <!-- Upload Limit Row -->
                        <CheckBox x:Name="UlCheckBox"
                                  Content="Limit Upload Speed (UL)"
                                  Foreground="#FF9F0A"
                                  FontWeight="Bold"
                                  IsChecked="False"
                                  Click="OnLimitCheckBoxClicked"
                                  Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UlValEntry"
                                     Grid.Column="0"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="500"
                                     Margin="0,0,6,0" />
                            <ComboBox x:Name="UlUnitCombo"
                                      Grid.Column="1"
                                      Height="32"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="MB/s" />
                                <ComboBoxItem Content="KB/s" />
                                <ComboBoxItem Content="Mbps" />
                                <ComboBoxItem Content="Kbps" />
                            </ComboBox>
                        </Grid>

                        <!-- Form Buttons -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ApplyBtn"
                                    Grid.Column="0"
                                    Height="44"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Background="#16222F"
                                    BorderBrush="#00F0FF"
                                    BorderThickness="1.5"
                                    Foreground="#00F0FF"
                                    Content="⚡ Apply Policies"
                                    Click="OnApplyPolicyClicked"
                                    Margin="0,0,6,0" />
                            <Button x:Name="DeleteBtn"
                                    Grid.Column="1"
                                    Height="44"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Background="#22181C"
                                    BorderBrush="#FF375F"
                                    BorderThickness="1"
                                    Foreground="#FF889E"
                                    Content="❌ Delete Rule"
                                    Click="OnDeletePolicyClicked" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Active Rules Registry Database -->
                <Border Grid.Row="1"
                        Background="#111115"
                        BorderBrush="#1D1D22"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="📂 ACTIVE RULES REGISTRY DATABASE:"
                                   Foreground="#828292"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Margin="0,0,0,8" />

                        <DataGrid x:Name="RulesGrid"
                                  Grid.Row="1"
                                  Foreground="#FFFFFF"
                                  FontSize="12"
                                  MouseDoubleClick="OnRulesDoubleClicked">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#111115" />
                                    <Setter Property="Foreground" Value="#828292" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#1D1D22" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Padding" Value="0,4" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0A84FF" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Application Executable" Binding="{Binding App}" Width="*" />
                                <DataGridTextColumn Header="DL Cap Limit" Binding="{Binding DlLimit}" Width="95" />
                                <DataGridTextColumn Header="UL Cap Limit" Binding="{Binding UlLimit}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. Console Log Output Panel -->
        <Border Grid.Row="3"
                Background="#111115"
                BorderBrush="#1D1D22"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="SYSTEM CONSOLE LOG ACTIVITY OUTPUT:"
                           Foreground="#828292"
                           FontWeight="Bold"
                           FontSize="10"
                           Margin="0,0,0,4" />
                <TextBox x:Name="ConsoleLogBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#828292"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 4. Status Bar -->
        <Border Grid.Row="4"
                Background="#111115"
                BorderBrush="#1D1D22"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6">
            <TextBlock x:Name="StatusLabel"
                       Text="🟢 Engine Ready. System operational."
                       Foreground="#00FF88"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
