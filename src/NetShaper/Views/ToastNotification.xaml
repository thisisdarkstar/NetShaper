<Window x:Class="NetShaper.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Border Background="#111115"
            BorderBrush="#25252E"
            BorderThickness="1"
            CornerRadius="8"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <Grid Margin="12,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Accent Bar Indicator -->
            <Border x:Name="IndicatorBar"
                    Grid.Column="0"
                    CornerRadius="2"
                    Background="#0A84FF" />

            <!-- Toast Content -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="TITLE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#0A84FF"
                           Margin="0,0,0,2" />
                <TextBlock x:Name="MessageText"
                           Text="Toast notification message description here."
                           FontSize="12"
                           Foreground="#FFFFFF" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
