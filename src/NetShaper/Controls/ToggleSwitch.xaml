<UserControl x:Class="NetShaper.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="54" Height="26" Cursor="Hand" MouseLeftButtonDown="OnToggleClicked">
    <Grid>
        <!-- Pill Track Background -->
        <Border x:Name="TrackBorder"
                CornerRadius="13"
                Background="#1B1B22"
                BorderBrush="#2A2A35"
                BorderThickness="1" />

        <!-- Sliding Circular Knob -->
        <Canvas>
            <Ellipse x:Name="Knob"
                     Width="18" Height="18"
                     Fill="#E2E2EA"
                     Canvas.Top="4" Canvas.Left="4">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>
    </Grid>
</UserControl>
